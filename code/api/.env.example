# ---- Runtime ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ---- Database ----
# Matches code/db/docker-compose.yml.
# Use 127.0.0.1 (not localhost): Git Bash on Windows resolves localhost to ::1
# first, and Docker Desktop does not always answer there.
# On Render: use the Internal Connection String of your Postgres service.
DATABASE_URL=postgres://myuser:mypassword@127.0.0.1:5432/nailsalon?sslmode=disable
# Used by the admin creation script.
# Must use a database account with admin permissions, not the regular application account.
ADMIN_DATABASE_URL=postgres://myuser:mypassword@127.0.0.1:5432/nailsalon?sslmode=disable
# ---- Sessions ----
# Min 32 chars. Generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-please-change-me-at-least-32-chars-long

# ---- CORS ----
# Frontend origin. In prod, set to the Vercel URL.
CORS_ORIGIN=http://localhost:3000

# ---- Maps ----
# Mapbox access token. Optional until travel-fee quoting is implemented.
MAPS_API_KEY=
